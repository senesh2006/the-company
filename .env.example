# Environment Variables
PROJECT_NAME="The Company"
API_V1_STR="/api/v1"
ENVIRONMENT=local

# LLM Providers (at least one is required)
# NVIDIA NIM (OpenAI-compatible inference at build.nvidia.com)
NVIDIA_API_KEY="nvapi-..."
# Optional override for any NVIDIA model ID (e.g. meta/llama-3.3-70b-instruct)
NVIDIA_CUSTOM_MODEL=""
# Groq (OpenAI-compatible API, fast alternative)
GROQ_API_KEY="gsk_..."
# Optional override for any Groq model ID
GROQ_CUSTOM_MODEL=""
# Gemini / Google AI Studio (OpenAI-compatible inference at aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."
GOOGLE_API_KEY="AIzaSy..."
GOOGLE_SHEETS_SPREADSHEET_ID=""
# OpenAI - optional if you use NVIDIA NIM, Groq, or Gemini
OPENAI_API_KEY="sk-..."

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Database Configuration (only needed if not using Supabase)
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=company_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration
# Generate a secure string for production: `openssl rand -hex 32`
SECRET_KEY="replace-this-with-a-secure-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MCP Servers (leave empty to use fallback/local implementations)
MCP_FALLBACK_MODE=True

# Payments
STRIPE_MCP_URL=""
STRIPE_MCP_API_KEY=""
# Direct Stripe integration (preferred if you want fewer MCPs)
STRIPE_API_KEY="sk_test_..."

# Knowledge & Workspace
NOTION_MCP_URL=""
NOTION_MCP_TOKEN=""
SLACK_MCP_URL=""
SLACK_MCP_BOT_TOKEN="xoxb-..."
GOOGLE_MCP_URL=""
GOOGLE_MCP_CREDENTIALS=""

# Search & Browser
BRAVE_MCP_URL=""
BRAVE_MCP_API_KEY=""
BROWSER_MCP_URL=""
BROWSER_MCP_API_KEY=""

# Email & Calendar
EMAIL_MCP_URL=""
EMAIL_MCP_API_KEY=""
CALENDAR_MCP_URL=""
CALENDAR_MCP_API_KEY=""

# Database & Context
SUPABASE_MCP_URL=""
SUPABASE_MCP_KEY=""
CONTEXT7_MCP_URL=""
CONTEXT7_MCP_API_KEY=""

# Cross-agent collaboration
COLLABORATION_MCP_URL=""
COLLABORATION_MCP_API_KEY=""
